# Server Configuration
PORT=3000
NODE_ENV=development
WEBHOOK_URL=https://your-domain.com

# Calendly Configuration
CALENDLY_API_TOKEN=your_calendly_personal_access_token
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_signing_secret

# Zoom Configuration (Server-to-Server OAuth)
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_ACCOUNT_ID=your_zoom_account_id

# Ellevelabs Configuration
ELLEVELABS_API_KEY=your_ellevelabs_api_key
ELLEVELABS_API_BASE=https://api.ellevelabs.com
ELLEVELABS_AGENT_ID=your_agent_id
